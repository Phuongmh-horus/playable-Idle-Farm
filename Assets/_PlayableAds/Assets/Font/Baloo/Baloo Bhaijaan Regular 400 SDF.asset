      \u0432\u0440\u0435\u043C\u044F \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435.
      \u0421\u043F\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F?\t\uD0C0\uC774\uBC0D\uACFC
      \uBC29\uD5A5\uC774 \uC911\uC694\uD569\uB2C8\uB2E4. \uD560 \uC218 \uC788\uB098\uC694?\t\u30BF\u30A4\u30DF\u30F3\u30B0\u3068\u65B9\u5411\u304C\u9375\u3002\u3067\u304D\u308B\uFF1F\t\u0938\u0939\u0940
